<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="Tokens.uss" />
    <Style src="Hud.uss" />
    <ui:VisualElement name="root" class="dc-root" picking-mode="Ignore">

        <!-- Top bar: identity on the left, mode on the right. Link health has its own panel. -->
        <ui:VisualElement name="topbar" class="dc-topbar">
            <ui:VisualElement class="dc-topbar__group">
                <ui:Label text="DC&lt;color=#19D3FF&gt;//&lt;/color&gt;TELEOP" class="dc-brand" enable-rich-text="true" />
                <ui:Label name="section-label" text="SECTION A · SERVER HALL" class="dc-chip dc-chip--accent" />
            </ui:VisualElement>
            <ui:VisualElement class="dc-topbar__group">
                <ui:Button name="assist-button" text="ASSIST ON" class="dc-button dc-button--active" />
                <ui:Button name="demo-button" text="AUTO DEMO" class="dc-button" />
                <ui:Button name="tutorial-button" text="TUTORIAL" class="dc-button" />
                <ui:Button name="link-button" text="LINK" class="dc-button" />
                <ui:Button name="mode-direct" text="DIRECT" class="dc-button dc-button--active" />
                <ui:Button name="mode-console" text="CONSOLE" class="dc-button" />
                <ui:Label name="input-source" text="Keyboard + Mouse" class="dc-label-muted" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Left: fleet -->
        <ui:VisualElement class="dc-column dc-column--left" picking-mode="Ignore">
            <ui:VisualElement class="dc-panel dc-fleet">
                <ui:VisualElement class="dc-panel__header">
                    <ui:Label text="ROBOTS" class="dc-panel__title" />
                    <ui:Label name="robot-count" text="0 online" class="dc-label-muted" />
                </ui:VisualElement>
                <ui:VisualElement name="robot-list" />
            </ui:VisualElement>
            <ui:VisualElement class="dc-panel dc-wristcam">
                <ui:VisualElement class="dc-panel__header">
                    <ui:Label text="WRIST CAM" class="dc-panel__title" />
                    <ui:Label name="wristcam-rate" text="-- fps" class="dc-label-muted" />
                </ui:VisualElement>
                <ui:VisualElement name="wristcam-view" class="dc-wristcam__view">
                    <ui:Label name="wristcam-overlay" text="" class="dc-wristcam__overlay" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Link panel: network impairments, opened from the top bar -->
        <ui:VisualElement name="link-panel" class="dc-panel dc-link-panel dc-hidden">
            <ui:VisualElement class="dc-panel__header">
                <ui:Label text="SIMULATED LINK" class="dc-panel__title" />
                <ui:Label name="link-inflight" text="0 in flight" class="dc-label-muted" />
            </ui:VisualElement>
            <ui:VisualElement name="link-presets" class="dc-link-presets" />
            <ui:Slider name="link-latency-slider" label="Latency (ms)" low-value="0" high-value="1000" show-input-field="true" class="dc-slider" />
            <ui:Slider name="link-jitter-slider" label="Jitter (ms)" low-value="0" high-value="300" show-input-field="true" class="dc-slider" />
            <ui:Slider name="link-loss-slider" label="Packet loss (%)" low-value="0" high-value="50" show-input-field="true" class="dc-slider" />
            <ui:Label name="link-detail" text="" class="dc-label-muted dc-link-detail" />
        </ui:VisualElement>

        <!-- Tutorial card -->
        <ui:VisualElement name="tutorial" class="dc-panel dc-tutorial dc-hidden">
            <ui:VisualElement class="dc-panel__header">
                <ui:Label name="tutorial-step" text="STEP 1 / 6" class="dc-panel__title" />
                <ui:Label name="tutorial-time" text="0s" class="dc-label-muted" />
            </ui:VisualElement>
            <ui:Label name="tutorial-text" text="" class="dc-tutorial__text" />
            <ui:VisualElement class="dc-tutorial__footer">
                <ui:VisualElement name="tutorial-dots" class="dc-tutorial__dots" />
                <ui:Button name="tutorial-skip" text="SKIP" class="dc-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Console mode on the desktop: on-screen sticks -->
        <ui:VisualElement name="console" class="dc-panel dc-console dc-hidden">
            <ui:VisualElement class="dc-panel__header">
                <ui:Label text="CONSOLE" class="dc-panel__title" />
                <ui:Label text="Hold SPACE while using" class="dc-label-muted" />
            </ui:VisualElement>
            <ui:VisualElement name="console-sticks" class="dc-console__sticks" />
        </ui:VisualElement>

        <!-- Proximity readout, above the deadman banner -->
        <ui:VisualElement name="proximity" class="dc-proximity" picking-mode="Ignore">
            <ui:VisualElement name="proximity-dot" class="dc-dot dc-dot--ok" />
            <ui:Label text="PROXIMITY" class="dc-stat__label" />
            <ui:Label name="proximity-value" text="clear" class="dc-stat__value" />
            <ui:Label name="proximity-cap" text="" class="dc-label-muted" />
            <ui:Label text="CMD GAP" class="dc-stat__label dc-proximity__gap" />
            <ui:Label name="command-gap" text="0 mm" class="dc-stat__value" />
        </ui:VisualElement>

        <!-- Right: work orders -->
        <ui:VisualElement class="dc-column dc-column--right" picking-mode="Ignore">
            <ui:VisualElement class="dc-panel dc-order">
                <ui:VisualElement class="dc-panel__header">
                    <ui:Label name="order-id" text="WO-A-001" class="dc-order__id" />
                    <ui:Label name="order-status" text="ACTIVE" class="dc-chip dc-chip--accent" />
                </ui:VisualElement>
                <ui:Label name="order-summary" text="-" class="dc-order__summary" />
                <ui:VisualElement name="order-cable-row" class="dc-order__cable">
                    <ui:Label text="CABLE" class="dc-order__cable-tag" />
                    <ui:Label name="order-cable" text="" class="dc-order__cable-text" />
                </ui:VisualElement>
                <ui:VisualElement class="dc-order__next">
                    <ui:Label text="NEXT" class="dc-order__next-tag" />
                    <ui:Label name="order-next" text="" class="dc-order__next-text" />
                </ui:VisualElement>
                <ui:VisualElement name="order-keys" class="dc-keys" />
                <ui:VisualElement name="endpoint-from" class="dc-order__endpoint">
                    <ui:VisualElement name="endpoint-from-dot" class="dc-dot" />
                    <ui:Label text="FROM" class="dc-order__endpoint-label" />
                    <ui:VisualElement class="dc-order__endpoint-text">
                        <ui:Label name="endpoint-from-port" text="-" class="dc-order__endpoint-port" />
                        <ui:Label name="endpoint-from-where" text="" class="dc-label-muted" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="endpoint-to" class="dc-order__endpoint">
                    <ui:VisualElement name="endpoint-to-dot" class="dc-dot" />
                    <ui:Label text="TO" class="dc-order__endpoint-label" />
                    <ui:VisualElement class="dc-order__endpoint-text">
                        <ui:Label name="endpoint-to-port" text="-" class="dc-order__endpoint-port" />
                        <ui:Label name="endpoint-to-where" text="" class="dc-label-muted" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="dc-order__stats">
                    <ui:VisualElement class="dc-order__stat">
                        <ui:Label text="TIME" class="dc-label-muted" />
                        <ui:Label name="order-elapsed" text="0:00" class="dc-order__stat-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dc-order__stat">
                        <ui:Label text="ERRORS" class="dc-label-muted" />
                        <ui:Label name="order-errors" text="0" class="dc-order__stat-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dc-order__stat">
                        <ui:Label text="GRIPPER" class="dc-label-muted" />
                        <ui:Label name="gripper-state" text="OPEN" class="dc-order__stat-value" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="dc-progress-row dc-order__progress">
                    <ui:VisualElement class="dc-bar">
                        <ui:VisualElement name="section-progress" class="dc-bar__fill dc-bar__fill--ok" />
                    </ui:VisualElement>
                    <ui:Label name="section-progress-label" text="0 / 0" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Link health and frame rate, with the last few seconds of each -->
            <ui:VisualElement name="perf" class="dc-panel dc-perf" picking-mode="Ignore">
                <ui:VisualElement class="dc-panel__header">
                    <ui:Label text="LINK &amp; PERFORMANCE" class="dc-panel__title" />
                </ui:VisualElement>
                <ui:VisualElement class="dc-perf__row">
                    <ui:VisualElement class="dc-perf__metric">
                        <ui:Label text="LATENCY" class="dc-stat__label" />
                        <ui:Label name="link-latency" text="-- ms" class="dc-perf__value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="latency-graph" class="dc-perf__graph dc-perf__graph--latency" />
                </ui:VisualElement>
                <ui:VisualElement class="dc-perf__row">
                    <ui:VisualElement class="dc-perf__metric">
                        <ui:Label text="FPS" class="dc-stat__label" />
                        <ui:Label name="fps" text="--" class="dc-perf__value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="fps-graph" class="dc-perf__graph dc-perf__graph--fps" />
                </ui:VisualElement>
                <ui:VisualElement class="dc-perf__footer">
                    <ui:VisualElement class="dc-stat">
                        <ui:Label text="FRAME" class="dc-stat__label" />
                        <ui:Label name="perf-frame" text="-- ms" class="dc-stat__value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dc-stat">
                        <ui:Label text="LOSS" class="dc-stat__label" />
                        <ui:Label name="link-loss" text="0.0%" class="dc-stat__value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="dc-stat">
                        <ui:Label text="CMD AGE" class="dc-stat__label" />
                        <ui:Label name="link-age" text="-- ms" class="dc-stat__value" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Bottom centre: keyboard controls, above the deadman banner. C hides and shows it. -->
        <ui:VisualElement name="help" class="dc-panel dc-help">
            <ui:VisualElement class="dc-panel__header">
                <ui:Label text="KEYBOARD CONTROLS" class="dc-panel__title" />
                <ui:Label text="Hold a key to move · let go to stop" class="dc-label-muted dc-help__hint" />
                <ui:Button name="help-toggle" text="HIDE  (C)" class="dc-button" />
            </ui:VisualElement>
            <ui:VisualElement name="help-body" class="dc-help__body" />
        </ui:VisualElement>

        <!-- Bottom right: facility minimap -->
        <ui:VisualElement name="minimap-panel" class="dc-panel dc-minimap-panel">
            <ui:VisualElement class="dc-panel__header">
                <ui:Label text="FACILITY" class="dc-panel__title" />
                <ui:Label text="Click robot: select  ·  Space+click: send" class="dc-label-muted" />
            </ui:VisualElement>
            <ui:VisualElement name="minimap" class="dc-minimap-host" />
        </ui:VisualElement>

        <!-- Bottom centre: deadman state -->
        <ui:VisualElement name="deadman" class="dc-deadman" picking-mode="Ignore">
            <ui:Label name="deadman-key" text="HOLD" class="dc-deadman__key" />
            <ui:Label name="deadman-text" text="HOLD TO ENABLE MOTION" class="dc-deadman__text" />
        </ui:VisualElement>

        <!-- Bottom right: E-Stop -->
        <ui:VisualElement name="estop" class="dc-estop">
            <ui:Button name="estop-button" text="E-STOP" class="dc-estop__button" />
            <ui:Button name="estop-reset" text="RESET  (SHIFT+BKSP)" class="dc-button dc-estop__reset" />
        </ui:VisualElement>

        <ui:VisualElement name="toasts" class="dc-toasts" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
