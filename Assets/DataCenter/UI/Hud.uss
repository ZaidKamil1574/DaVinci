/* Operator HUD. Values come from Tokens.uss; only layout lives here. */

.dc-root {
    flex-grow: 1;
    color: var(--dc-text);
    font-size: var(--dc-font-sm);
}

/* ---------- Shared building blocks ---------- */

.dc-panel {
    background-color: var(--dc-surface);
    border-color: var(--dc-border);
    border-width: 1px;
    border-radius: var(--dc-radius-2);
    padding: var(--dc-space-3);
}

.dc-panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--dc-space-2);
}

.dc-panel__title {
    font-size: var(--dc-font-xs);
    color: var(--dc-text-muted);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.dc-label-muted {
    color: var(--dc-text-muted);
    font-size: var(--dc-font-xs);
}

.dc-mono {
    -unity-font-style: bold;
}

.dc-chip {
    padding: 2px var(--dc-space-2);
    border-radius: var(--dc-radius-pill);
    font-size: var(--dc-font-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    background-color: var(--dc-surface-raised);
    color: var(--dc-text-muted);
}

.dc-chip--ok { background-color: var(--dc-ok-dim); color: var(--dc-ok); }
.dc-chip--accent { background-color: var(--dc-accent-dim); color: var(--dc-accent); }
.dc-chip--warn { background-color: var(--dc-warn-dim); color: var(--dc-warn); }
.dc-chip--danger { background-color: var(--dc-danger-dim); color: var(--dc-danger); }

.dc-bar {
    height: 6px;
    border-radius: var(--dc-radius-pill);
    background-color: var(--dc-surface-sunken);
    overflow: hidden;
    flex-grow: 1;
}

.dc-bar__fill {
    height: 100%;
    width: 50%;
    border-radius: var(--dc-radius-pill);
    background-color: var(--dc-accent);
}

.dc-bar__fill--ok { background-color: var(--dc-ok); }
.dc-bar__fill--warn { background-color: var(--dc-warn); }
.dc-bar__fill--danger { background-color: var(--dc-danger); }

.dc-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--dc-radius-pill);
    background-color: var(--dc-text-faint);
    margin-right: var(--dc-space-2);
}

.dc-dot--ok { background-color: var(--dc-ok); }
.dc-dot--accent { background-color: var(--dc-accent); }
.dc-dot--warn { background-color: var(--dc-warn); }

.dc-button {
    background-color: var(--dc-surface-raised);
    border-color: var(--dc-border-strong);
    border-width: 1px;
    border-radius: var(--dc-radius-1);
    color: var(--dc-text);
    font-size: var(--dc-font-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: var(--dc-space-1) var(--dc-space-3);
    margin: 0;
}

.dc-button:hover {
    border-color: var(--dc-accent);
}

.dc-button--active {
    background-color: var(--dc-accent-dim);
    border-color: var(--dc-accent);
    color: var(--dc-accent);
}

/* ---------- Top bar ---------- */

.dc-topbar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--dc-topbar-height);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--dc-space-4);
    background-color: var(--dc-surface);
    border-bottom-width: 1px;
    border-color: var(--dc-border);
}

.dc-topbar__group {
    flex-direction: row;
    align-items: center;
}

.dc-topbar__group > * {
    margin-right: var(--dc-space-4);
}

.dc-brand {
    font-size: var(--dc-font-md);
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: var(--dc-text);
}

.dc-brand__accent {
    color: var(--dc-accent);
}

.dc-stat {
    flex-direction: row;
    align-items: center;
}

.dc-stat__label {
    color: var(--dc-text-muted);
    font-size: var(--dc-font-xs);
    margin-right: var(--dc-space-1);
    letter-spacing: 1px;
}

.dc-stat__value {
    -unity-font-style: bold;
    font-size: var(--dc-font-sm);
    min-width: 44px;
}

/* ---------- Columns ---------- */

.dc-column {
    position: absolute;
    top: 56px;
}

/* The fleet list is narrow; the wrist camera under it is wider, so the column sizes to that. */
.dc-column--left {
    left: var(--dc-space-3);
    align-items: flex-start;
}

.dc-fleet {
    width: var(--dc-column-left);
}

.dc-wristcam {
    width: var(--dc-wristcam-width);
}

.dc-column--right {
    right: var(--dc-space-3);
    width: var(--dc-column-right);
}

.dc-column > .dc-panel {
    margin-bottom: var(--dc-space-3);
}

/* ---------- Robot cards ---------- */

/* Two lines per robot: name, id and state; then battery and current task. */
.dc-robot-card {
    background-color: var(--dc-surface-raised);
    border-radius: var(--dc-radius-1);
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    padding: 5px var(--dc-space-2);
    margin-bottom: var(--dc-space-1);
}

.dc-robot-card:hover {
    background-color: rgba(40, 52, 68, 0.95);
}

.dc-robot-card--selected {
    border-color: var(--dc-accent);
}

.dc-robot-card__row {
    flex-direction: row;
    align-items: center;
}

.dc-robot-card__row--detail {
    margin-top: 3px;
}

.dc-robot-card__name {
    font-size: var(--dc-font-sm);
    -unity-font-style: bold;
}

.dc-robot-card__id {
    flex-grow: 1;
    margin-left: var(--dc-space-2);
}

.dc-robot-card__bar {
    width: 44px;
    flex-grow: 0;
    flex-shrink: 0;
}

.dc-robot-card__battery {
    width: 32px;
    margin-left: var(--dc-space-1);
    font-size: var(--dc-font-xs);
    color: var(--dc-text-muted);
}

.dc-robot-card__task {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* ---------- Work orders ---------- */

/* Compact: the order id is the card title, stats sit on one line. */
.dc-order {
    padding: var(--dc-space-2) var(--dc-space-3);
}

.dc-order > .dc-panel__header {
    margin-bottom: var(--dc-space-1);
}

.dc-order__id {
    font-size: var(--dc-font-sm);
    color: var(--dc-accent);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.dc-order__summary {
    font-size: var(--dc-font-sm);
    white-space: normal;
    margin-bottom: var(--dc-space-2);
}

.dc-order__endpoint {
    flex-direction: row;
    align-items: center;
    background-color: var(--dc-surface-sunken);
    border-radius: var(--dc-radius-1);
    padding: 3px var(--dc-space-2);
    margin-bottom: 2px;
}

.dc-order__endpoint-label {
    width: 36px;
    color: var(--dc-text-muted);
    font-size: var(--dc-font-xs);
}

/* "Patch panel port 12  in rack A-R03" on one line. */
.dc-order__endpoint-text {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.dc-order__endpoint-text > .dc-label-muted {
    margin-left: var(--dc-space-2);
}

.dc-order__endpoint-port {
    -unity-font-style: bold;
    font-size: var(--dc-font-xs);
}

/* What the cable is, in a sentence, for anyone who has never handled one. */
.dc-order__cable {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: var(--dc-space-2);
}

.dc-order__cable-tag {
    color: var(--dc-text-muted);
    font-size: var(--dc-font-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: var(--dc-space-2);
}

.dc-order__cable-text {
    flex-shrink: 1;
    white-space: normal;
    font-size: var(--dc-font-xs);
    color: var(--dc-text-muted);
}

.dc-order__stats {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--dc-space-2);
}

.dc-order__stat {
    flex-direction: row;
    align-items: center;
}

.dc-order__stat > .dc-label-muted {
    margin-right: var(--dc-space-1);
}

.dc-order__stat-value {
    font-size: var(--dc-font-sm);
    -unity-font-style: bold;
}

.dc-order__progress {
    margin-top: var(--dc-space-1);
}

.dc-order__queue-title {
    margin-top: var(--dc-space-2);
}

.dc-order-row {
    flex-direction: row;
    align-items: center;
    padding: var(--dc-space-1) 0;
}

.dc-order-row__text {
    font-size: var(--dc-font-xs);
    color: var(--dc-text-muted);
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.dc-order-row--active .dc-order-row__text {
    color: var(--dc-text);
}

.dc-progress-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--dc-space-2);
}

.dc-progress-row > Label {
    margin-left: var(--dc-space-2);
    font-size: var(--dc-font-xs);
    color: var(--dc-text-muted);
}

/* ---------- Deadman banner ---------- */

.dc-deadman {
    position: absolute;
    bottom: var(--dc-space-5);
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: var(--dc-space-2) var(--dc-space-4);
    border-radius: var(--dc-radius-pill);
    background-color: var(--dc-surface);
    border-width: 1px;
    border-color: var(--dc-border-strong);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.dc-deadman__key {
    padding: 2px var(--dc-space-2);
    border-radius: var(--dc-radius-1);
    border-width: 1px;
    border-color: var(--dc-border-strong);
    font-size: var(--dc-font-xs);
    -unity-font-style: bold;
    margin-right: var(--dc-space-2);
}

.dc-deadman__text {
    font-size: var(--dc-font-sm);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.dc-deadman--live {
    background-color: var(--dc-ok-dim);
    border-color: var(--dc-ok);
}

.dc-deadman--live .dc-deadman__text {
    color: var(--dc-ok);
}

.dc-deadman--stopped {
    background-color: var(--dc-danger-dim);
    border-color: var(--dc-danger);
}

.dc-deadman--stopped .dc-deadman__text {
    color: var(--dc-danger);
}

/* ---------- E-Stop ---------- */

.dc-estop {
    position: absolute;
    right: var(--dc-space-4);
    bottom: var(--dc-space-4);
    align-items: center;
}

.dc-estop__button {
    width: 104px;
    height: 104px;
    border-radius: 52px;
    border-width: 7px;
    border-color: var(--dc-estop-ring);
    background-color: var(--dc-estop);
    color: rgb(255, 255, 255);
    font-size: var(--dc-font-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.dc-estop__button:hover {
    scale: 1.04 1.04;
}

.dc-estop__button:active {
    scale: 0.96 0.96;
}

.dc-estop__button--latched {
    background-color: rgb(120, 12, 10);
}

.dc-estop__reset {
    margin-top: var(--dc-space-2);
    display: none;
}

.dc-estop--latched .dc-estop__reset {
    display: flex;
}

/* ---------- Minimap ---------- */

.dc-minimap-panel {
    position: absolute;
    right: 136px;
    bottom: var(--dc-space-4);
    width: 240px;
    height: 170px;
}

.dc-minimap-host {
    flex-grow: 1;
}

/* Colours for the hand-drawn minimap, read by MinimapElement as custom properties. */
.dc-minimap {
    flex-grow: 1;
    --minimap-floor: var(--dc-surface-sunken);
    --minimap-equipment: var(--dc-border-strong);
    --minimap-ok: var(--dc-ok);
    --minimap-active: var(--dc-accent);
    --minimap-warn: var(--dc-warn);
    --minimap-danger: var(--dc-danger);
    --minimap-selected: var(--dc-text);
}

.dc-minimap__zone-label {
    position: absolute;
    font-size: var(--dc-font-xs);
    -unity-font-style: bold;
}

/* ---------- Controls panel ---------- */

/* Between the fleet column and the minimap, above the proximity and deadman pills. */
/* Beside the wrist camera, short of the minimap. */
.dc-help {
    position: absolute;
    left: 354px;
    right: 428px;
    bottom: 104px;
    padding: var(--dc-space-2) var(--dc-space-3);
}

.dc-help > .dc-panel__header {
    margin-bottom: var(--dc-space-1);
}

.dc-help__hint {
    flex-grow: 1;
    margin-left: var(--dc-space-3);
}

.dc-help__body {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.dc-help--collapsed .dc-help__body,
.dc-help--collapsed .dc-help__hint {
    display: none;
}

.dc-help--collapsed {
    left: auto;
    right: 428px;
}

.dc-help--collapsed .dc-panel__header {
    margin-bottom: 0;
}

.dc-help__group {
    margin-right: var(--dc-space-1);
}

.dc-help__group-title {
    color: var(--dc-accent);
    font-size: var(--dc-font-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: var(--dc-space-1);
}

.dc-help__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.dc-help__keys {
    flex-direction: row;
    align-items: center;
    margin-right: var(--dc-space-1);
}

.dc-help__plus {
    color: var(--dc-text-muted);
    font-size: var(--dc-font-xs);
    margin: 0 2px 0 -1px;
}

.dc-help__action {
    color: var(--dc-text);
    font-size: var(--dc-font-xs);
    flex-shrink: 1;
}

/* A key cap: raised, with a heavier bottom edge, so it reads as a key at a glance. */
.dc-key {
    min-width: 20px;
    padding: 1px 5px;
    margin-right: 3px;
    border-radius: var(--dc-radius-1);
    border-width: 1px;
    border-bottom-width: 2px;
    border-color: var(--dc-border-strong);
    background-color: var(--dc-surface-raised);
    color: var(--dc-text);
    font-size: var(--dc-font-xs);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Live key hints under the NEXT step. */
.dc-keys {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--dc-space-2);
}

.dc-keys__item {
    flex-direction: row;
    align-items: center;
    padding: 2px 6px 2px 2px;
    margin: 0 var(--dc-space-1) var(--dc-space-1) 0;
    border-radius: var(--dc-radius-1);
    background-color: var(--dc-accent-dim);
}

.dc-keys__item .dc-key {
    border-color: var(--dc-accent);
    color: var(--dc-accent);
}

.dc-keys__action {
    font-size: var(--dc-font-xs);
    color: var(--dc-text);
    margin-left: 2px;
}

/* ---------- Next step guidance ---------- */

.dc-order__next {
    flex-direction: row;
    align-items: flex-start;
    background-color: var(--dc-accent-dim);
    border-left-width: 3px;
    border-color: var(--dc-accent);
    border-radius: var(--dc-radius-1);
    padding: var(--dc-space-2);
    margin-bottom: var(--dc-space-2);
}

.dc-order__next-tag {
    color: var(--dc-accent);
    font-size: var(--dc-font-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: var(--dc-space-2);
}

.dc-order__next-text {
    flex-shrink: 1;
    white-space: normal;
    font-size: var(--dc-font-sm);
}

/* ---------- Link and performance ---------- */

/* Under the work order: latency and frame rate as numbers with a graph each, then the rest. */
.dc-perf {
    padding: var(--dc-space-2) var(--dc-space-3);
}

.dc-perf > .dc-panel__header {
    margin-bottom: var(--dc-space-1);
}

.dc-perf__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--dc-space-1);
}

.dc-perf__metric {
    width: 96px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-right: var(--dc-space-2);
}

.dc-perf__value {
    font-size: var(--dc-font-sm);
    -unity-font-style: bold;
}

.dc-perf__value--warn {
    color: var(--dc-warn);
}

.dc-perf__graph {
    flex-grow: 1;
    height: 22px;
    border-radius: var(--dc-radius-1);
    background-color: var(--dc-surface-sunken);
}

.dc-perf__graph .dc-sparkline {
    flex-grow: 1;
    margin: 3px;
    --sparkline-guide: var(--dc-border-strong);
}

.dc-perf__graph--latency .dc-sparkline {
    --sparkline-line: var(--dc-accent);
}

.dc-perf__graph--fps .dc-sparkline {
    --sparkline-line: var(--dc-ok);
}

.dc-perf__footer {
    flex-direction: row;
    justify-content: space-between;
}

.dc-perf__footer .dc-stat__value {
    font-size: var(--dc-font-xs);
    min-width: 0;
}

/* ---------- Utility ---------- */

.dc-hidden {
    display: none;
}

/* ---------- Wrist camera ---------- */

.dc-wristcam__view {
    height: 198px;
    border-radius: var(--dc-radius-1);
    background-color: var(--dc-surface-sunken);
    -unity-background-scale-mode: scale-and-crop;
    justify-content: flex-end;
}

.dc-wristcam__overlay {
    font-size: var(--dc-font-xs);
    color: var(--dc-text);
    background-color: rgba(0, 0, 0, 0.45);
    padding: 2px var(--dc-space-2);
    align-self: flex-start;
    border-radius: var(--dc-radius-1);
    margin: var(--dc-space-1);
}

/* ---------- Link panel ---------- */

.dc-link-panel {
    position: absolute;
    top: 52px;
    right: 360px;
    width: 380px;
}

.dc-link-presets {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--dc-space-2);
}

.dc-link-presets > Button {
    margin: 0 var(--dc-space-1) var(--dc-space-1) 0;
}

.dc-slider {
    margin: var(--dc-space-1) 0;
}

.dc-slider Label {
    color: var(--dc-text-muted);
    font-size: var(--dc-font-xs);
    min-width: 110px;
}

.dc-slider .unity-base-field__input {
    background-color: var(--dc-surface-sunken);
    color: var(--dc-text);
    border-color: var(--dc-border);
}

.dc-link-detail {
    margin-top: var(--dc-space-2);
    white-space: normal;
}

/* ---------- Tutorial ---------- */

.dc-tutorial {
    position: absolute;
    top: 56px;
    left: 50%;
    translate: -50% 0;
    width: 520px;
    border-color: var(--dc-ok);
}

.dc-tutorial__text {
    font-size: var(--dc-font-md);
    white-space: normal;
    margin-bottom: var(--dc-space-2);
}

.dc-tutorial__footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.dc-tutorial__dots {
    flex-direction: row;
}

.dc-toasts--below-tutorial {
    top: 200px;
}

/* ---------- Console sticks ---------- */

.dc-console {
    position: absolute;
    bottom: 110px;
    left: 50%;
    translate: -50% 0;
}

.dc-console__sticks {
    flex-direction: row;
    padding-bottom: var(--dc-space-4);
}

.dc-stick {
    width: 110px;
    height: 110px;
    border-radius: 55px;
    margin: 0 var(--dc-space-2);
    background-color: var(--dc-surface-sunken);
    border-width: 1px;
    border-color: var(--dc-border-strong);
    align-items: center;
    justify-content: center;
}

.dc-stick__knob {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: var(--dc-accent);
}

.dc-stick__label {
    position: absolute;
    bottom: -18px;
    font-size: var(--dc-font-xs);
    color: var(--dc-text-muted);
}

/* ---------- Proximity ---------- */

.dc-proximity {
    position: absolute;
    bottom: 68px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: var(--dc-space-1) var(--dc-space-3);
    border-radius: var(--dc-radius-pill);
    background-color: var(--dc-surface);
    border-width: 1px;
    border-color: var(--dc-border);
}

.dc-proximity__gap {
    margin-left: var(--dc-space-3);
}

.dc-proximity--warn {
    border-color: var(--dc-warn);
}

.dc-proximity--danger {
    border-color: var(--dc-danger);
    background-color: var(--dc-danger-dim);
}

.dc-dot--danger { background-color: var(--dc-danger); }

/* ---------- Toasts ---------- */

.dc-toasts {
    position: absolute;
    top: 56px;
    left: 50%;
    translate: -50% 0;
    width: 460px;
    align-items: stretch;
}

.dc-toast {
    background-color: var(--dc-surface-raised);
    border-left-width: 4px;
    border-color: var(--dc-accent);
    border-radius: var(--dc-radius-1);
    padding: var(--dc-space-2) var(--dc-space-3);
    margin-bottom: var(--dc-space-2);
    font-size: var(--dc-font-sm);
    white-space: normal;
    opacity: 1;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
}

.dc-toast--hidden {
    opacity: 0;
    translate: 0 -8px;
}

.dc-toast--success { border-color: var(--dc-ok); }
.dc-toast--warning { border-color: var(--dc-warn); }
.dc-toast--error { border-color: var(--dc-danger); }
